# UIUC Bustle backend configuration.
# Copy to `.env` and fill in. All values are read by settings.py via pydantic-settings.
# Field names map to UPPER_SNAKE_CASE env vars.

# --- Core ---
APP_NAME="UIUC Bus API"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated). Empty = block all cross-origin requests.
# Dev example:  CORS_ORIGINS=http://localhost:8081,http://localhost:3000
# Prod example: CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# --- Data / database ---
# PostgreSQL connection URL. Railway sets DATABASE_URL automatically in deploy.
DATABASE_URL=
# Path to the GTFS SQLite database (built by scripts/load_gtfs.py).
GTFS_DB_PATH=data/gtfs.db

# --- External APIs ---
# Champaign-Urbana MTD Developer API key (https://developer.cumtd.com).
MTD_API_KEY=
# Anthropic API key for AI features (https://console.anthropic.com).
CLAUDE_API_KEY=
# Google Places API (New) key for place search.
GOOGLE_PLACES_API_KEY=

# --- Auth ---
# Supabase JWT secret (Supabase dashboard → Settings → API → JWT Secret).
# Required for the authenticated endpoints (/recommendation, /ai/*, /schedule/*).
SUPABASE_JWT_SECRET=
# Supabase project URL — required to verify ES256/RS256 tokens via the project JWKS.
SUPABASE_URL=

# Optional API-key gate. When true, non-exempt requests must send X-API-Key.
API_KEY_REQUIRED=false
# Comma-separated list of valid API keys (no spaces). Example: API_KEYS=key1,key2
API_KEYS=

# --- Proxy / deployment ---
# Trust X-Forwarded-* headers from the fronting proxy (uvicorn). Set true only
# when a trusted proxy (e.g. Railway's edge) is the sole ingress; enables real
# per-client rate limiting instead of one shared bucket.
TRUST_PROXY_HEADERS=false
# Which proxy IPs uvicorn trusts for X-Forwarded-For. "*" is safe on Railway
# (edge proxy is the only ingress); never use "*" on a directly reachable host.
FORWARDED_ALLOW_IPS=

# --- Misc ---
# Base URL used to build share-trip links (e.g. https://your-app.up.railway.app).
# When unset, share responses return url=null (the Host header is never used,
# so an attacker-controlled Host cannot poison share links) — set it in
# production so the API can hand out complete links.
PUBLIC_BASE_URL=
# Sentry DSN for error monitoring (optional).
SENTRY_DSN=
